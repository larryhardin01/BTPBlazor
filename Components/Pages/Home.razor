@page "/"
@rendermode InteractiveServer
@using BTPBlazor.Services
@inject BtpTempFileService TempFileService
@inject IWebHostEnvironment WebHostEnvironment

<PageTitle>BTP Temp Message Writer</PageTitle>

<h1>Write a message to the BTP temp directory</h1>

<EditForm Model="_model" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label for="message" class="form-label">Message</label>
        <InputTextArea id="message" class="form-control" @bind-Value="_model.Message" rows="5" />
    </div>

    <button type="submit" class="btn btn-primary">Write to temp file</button>
</EditForm>

<button type="button" class="btn btn-secondary mt-3" @onclick="HandleTestLargeXmlClick">Test Large XML</button>

@if (_chunkLog.Count > 0)
{
    <div class="mt-3" style="max-height: 300px; overflow-y: auto;">
        @foreach (var entry in _chunkLog)
        {
            <div>@entry</div>
        }
    </div>
}

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <div class="alert alert-success mt-3">
        @_statusMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger mt-3">
        @_errorMessage
    </div>
}

@code {
    private readonly MessageRequest _model = new();
    private string? _statusMessage;
    private string? _errorMessage;

    private async Task HandleValidSubmit()
    {
        try
        {
            var targetDirectory = TempFileService.ResolveTempDirectory();
            var filePath = await TempFileService.WriteMessageAsync(_model.Message, targetDirectory);

            _statusMessage = $"Message was written successfully to {filePath}.";
            _errorMessage = null;
            _model.Message = string.Empty;
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            _statusMessage = null;
        }
    }

    private const int ChunkLogRenderInterval = 25;
    private readonly List<string> _chunkLog = new();

    private async Task HandleTestLargeXmlClick()
    {
        _chunkLog.Clear();
        _statusMessage = null;
        _errorMessage = null;

        try
        {
            var sourcePath = Path.Combine(WebHostEnvironment.ContentRootPath, "10MB_Payload.xml");
            var targetDirectory = TempFileService.ResolveTempDirectory();

            var onTargetFileCreated = new Action<string>(filePath =>
            {
                _chunkLog.Add($"Target file: {filePath}");
                StateHasChanged();
            });

            var progress = new Progress<int>(chunkNumber =>
            {
                _chunkLog.Add($"Chunk {chunkNumber} appended to file.");

                if (chunkNumber % ChunkLogRenderInterval == 0)
                {
                    StateHasChanged();
                }
            });

            var filePath = await TempFileService.CopyLargeXmlPayloadAsync(sourcePath, targetDirectory, progress, onTargetFileCreated);

            _statusMessage = $"Large XML payload was written successfully to {filePath}.";
            _errorMessage = null;
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            _statusMessage = null;
        }

        StateHasChanged();
    }

    private sealed class MessageRequest
    {
        public string Message { get; set; } = string.Empty;
    }
}
